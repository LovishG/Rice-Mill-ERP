{
  "name": "rice-mill-erp",
  "version": "1.0.0",
  "description": "Comprehensive Rice Mill ERP (Raw, Parboiled, Steamed, Basmati & CMR)",
  "scripts": {
    "start": "concurrently -n \"API,UI\" -c \"blue.bold,green.bold\" \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "npm run dev --prefix backend",
    "start:frontend": "npm start --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend"
  },
  "keywords": [
    "rice-mill",
    "erp",
    "angular22",
    "ng-zorro",
    "better-sqlite3",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
